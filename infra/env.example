# Copy to the repo root as .env and export it before starting the API.
# Never commit a filled-in .env.

# mock = deterministic agents, no Google calls.
# live = ADK calls Gemini when credentials below are set, then falls back.
TIPO_MODE=mock

# Checked against https://ai.google.dev/gemini-api/docs/models on 10 Oct 2026.
TIPO_MODEL_MAIN=gemini-3.8-flash
TIPO_MODEL_LITE=gemini-3.5-flash-lite
TIPO_MODEL_TRANSCRIBE=gemini-3.5-transcribe
TIPO_MODEL_EMBED=gemini-embedding-2-preview

# Gemini API key. Leave empty for mock mode.
GOOGLE_API_KEY=

# Or Vertex AI instead of an API key.
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-southeast2

# memory (default) or firestore
TIPO_STORE=memory
TIPO_FIRESTORE_PROJECT=

# Cloud Storage bucket for uploaded photos and voice notes. Empty = local disk.
TIPO_GCS_BUCKET=

# FCM. Requires a service account that can send messages.
TIPO_FCM=false
FIREBASE_SERVICE_ACCOUNT_JSON=

# Replay delay multiplier. 1 = the scripted ~78 seconds. 0 = instant (tests).
TIPO_REPLAY_SPEED=1
TIPO_NEARBY_RADIUS_M=2000
PORT=8765
